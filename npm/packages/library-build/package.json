{
  "name": "@helsenorge/library-build",
  "version": "40.0.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Norsk helsenett SF",
  "maintainers": [
    "ROX"
  ],
  "description": "Bygg og test av komponentbibliotek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helsenorge/core-frontend-packages.git"
  },
  "bin": {
    "library-scripts": "./lib/library-scripts.js"
  },
  "files": [
    "config",
    "lib"
  ],
  "exports": {
    "./config/tsconfig.global.json": "./config/tsconfig.global.json",
    "./config/tsconfig.node.json": "./config/tsconfig.node.json",
    "./config/tsconfig.vite.json": "./config/tsconfig.vite.json",
    "./copy": "./lib/copy.js",
    "./exports": "./lib/exports.js",
    "./library-scripts": "./lib/library-scripts.js",
    "./package.json": "./package.json",
    "./setupTests.vite": "./lib/setupTests.vite.js",
    "./vite.config": "./lib/vite.config.js",
    "./vitest.config": "./lib/vitest.config.js"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf lib",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "npm-run-all chmod exports",
    "chmod": "node -e \"require('fs').chmodSync('lib/library-scripts.js', 0o755)\"",
    "exports": "node ./lib/library-scripts.js exports",
    "watch": "tsc --watch",
    "eslint": "eslint src/**/*.{js,jsx,ts,tsx}",
    "eslint:fix": "npm run eslint -- --fix",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,md,json}\"",
    "prettier:fix": "npm run prettier -- --write",
    "pretypecheck": "tsc -v",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/yargs": "^17.0.35",
    "npm-run-all2": "^9.0.1"
  },
  "dependencies": {
    "@helsenorge/eslint-config": "^40.0.0",
    "@helsenorge/typed-scss-modules": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/copyfiles": "^2.4.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "copyfiles": "^2.4.1",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "yargs": "^18.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11.17.0"
  }
}
